{
  "name": "restricted-securities-sourcing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "dev:all": "concurrently \"./Launch\\ Scout\\ 144.command\" \"./Launch\\ Delisted\\ CRM.command\"",
    "client": "vite",
    "server": "node server.js",
    "build": "vite build",
    "build:all": "vite build && cd delisted-crm-database && npm run build && cd ../haas-adu-configurator && npm run build",
    "preview": "vite preview",
    "sync:daily": "node scripts/morning_sync.js",
    "benchmark": "node scripts/benchmark_launch.js",
    "spec:new": "bash scripts/new_spec.sh",
    "topology:generate": "node scripts/generate_topology.js",
    "test:smoke": "node scripts/smoke_test.js",
    "test:all": "node scripts/smoke_test.js",
    "deploy:all": "node scripts/deploy_all_regional_apps.js",
    "report:pdf": "node scripts/generate_report_pdf.cjs",
    "catalog:pdf": "node scripts/generate_adu_catalog_pdf.cjs",
    "deck:build": "python3 scripts/build_adu_presentation.py",
    "haas:dev": "cd haas-adu-configurator && npm run dev",
    "haas:build": "cd haas-adu-configurator && npm run build",
    "haas:deploy": "cd haas-adu-configurator && npx -y vercel --prod --yes"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.1.0"
  }
}
